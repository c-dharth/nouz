/* ============ experiences, relationship spaces, Mutual Match ============ */
const XCATS={dinner:"Dinner date",trip:"Trip",adventure:"Adventure",movie:"Movie",celebration:"Celebration",romantic:"Romantic",milestone:"Milestone",other:"Other"};
/* Generic ideas only. VOUZ names no venue and claims no price, opening hours or availability. */
const IDEAS=[
 ["newrest","Try a new restaurant","Somewhere neither of you has been.",2,2,"in",1,"near","food"],
 ["hike","Go hiking","Pick a trail with a view at the end.",0,3,"out",3,"day","outdoors adventure"],
 ["roadtrip","Take a road trip","No fixed plan past the first stop.",2,4,"out",2,"away","adventure"],
 ["cook","Cook something new together","A recipe neither of you has made.",1,2,"in",1,"home","food home"],
 ["concert","Go to a concert","Live music, any genre.",3,2,"in",2,"near","music culture"],
 ["romeve","Plan a romantic evening at home","Lights low, phones away.",1,2,"in",1,"home","romance home"],
 ["hood","Explore a new neighborhood","Walk it, eat there, get a little lost.",0,3,"out",2,"near","culture adventure"],
 ["picnic","Pack a picnic","Something simple, somewhere green.",1,2,"out",1,"near","food outdoors romance"],
 ["museum","Visit a museum or gallery","Each of you picks one piece to show the other.",1,2,"in",1,"near","culture learning"],
 ["sunrise","Watch the sunrise","Bring something warm to drink.",0,1,"out",2,"near","outdoors romance"],
 ["class","Take a class together","Cooking, pottery, dance, anything new to both of you.",2,2,"in",2,"near","learning"],
 ["movienight","Themed movie night","Pick a theme, a snack to match, and a double bill.",0,2,"in",1,"home","home"],
 ["stars","Stargaze away from city lights","Check the sky forecast first.",0,3,"out",1,"day","outdoors romance"],
 ["bike","Go for a bike ride","An easy loop with a stop for food.",0,2,"out",3,"near","outdoors wellness"],
 ["spa","Spa night at home","Face masks, a long bath, no schedule.",1,2,"in",1,"home","wellness romance"],
 ["market","Shop a farmers market, then cook","Let what you find decide dinner.",1,2,"out",1,"near","food"],
 ["getaway","Weekend getaway","Two nights somewhere new.",3,4,"in",2,"away","adventure romance"],
 ["games","Board-game night","Something new or an old favourite.",0,2,"in",1,"home","home"],
 ["dance","Go dancing","Lessons first if you want them.",1,2,"in",3,"near","music"],
 ["water","Beach or lake day","Swim, read, nap.",0,3,"out",2,"day","outdoors"],
 ["volunteer","Volunteer together","An afternoon for something you both care about.",0,3,"in",2,"near","learning"],
 ["letters","Write each other letters","Swap them over dinner.",0,1,"in",1,"home","romance"],
 ["books","Bookstore date","Choose a book for each other.",1,1,"in",1,"near","culture"],
 ["tasting","Wine, coffee or tea tasting","Compare notes, keep score if you like.",2,2,"in",1,"near","food"],
 ["photo","Photo walk","One camera each, same route, compare after.",0,2,"out",2,"near","outdoors culture"],
 ["show","Comedy or a live show","Something you'd both laugh at.",2,2,"in",1,"near","culture music"],
 ["stretch","Yoga or stretching together","Twenty slow minutes.",0,1,"in",2,"home","wellness"],
 ["dreamtrip","Plan a dream trip","Just the planning, no booking.",0,1,"in",1,"home","adventure"],
 ["firstdate","Recreate your first date","Or the closest you can get.",1,2,"in",1,"near","romance"],
 ["sport","Try a new sport","Climbing, paddleboarding, tennis.",1,2,"out",3,"near","adventure wellness"],
 ["brunch","Slow brunch","No alarms beforehand.",1,2,"in",1,"near","food"],
 ["garden","Botanical garden or big park","Walk until you find a bench you like.",0,2,"out",1,"near","outdoors"]
].map(([id,t,d,b,tm,w,e,ds,g])=>({id,t,d,b,tm,w,e,ds,g:g.split(" ")}));
const IDEA=Object.fromEntries(IDEAS.map(x=>[x.id,x]));
const BUD=["Free","$","$$","$$$"],TM=["","Up to an hour","2–3 hours","Half a day","A day or more"],EN=["","Low energy","Some energy","High energy"],DS={home:"At home",near:"Nearby",day:"Day trip",away:"Travel"},INTS={food:"Food",outdoors:"Outdoors",culture:"Culture",home:"Home",adventure:"Adventure",romance:"Romance",learning:"Learning",wellness:"Wellness",music:"Music"};
const ideaMeta=x=>[BUD[x.b],TM[x.tm],DS[x.ds],x.w==="out"?"Outdoors":"Indoors",EN[x.e]].join(" · ");
function ideaOk(x,f){return(f.b==null||x.b<=f.b)&&(f.tm==null||x.tm<=f.tm)&&(!f.w||x.w===f.w)&&(f.e==null||x.e===f.e)&&(!f.ds||x.ds===f.ds)&&(!(f.g&&f.g.length)||x.g.some(g=>f.g.includes(g)))}

/* ---- photos: kept on this device only, re-saved without location data, never uploaded ---- */
const Photos={db:null,urls:new Map(),ok:typeof indexedDB!=="undefined",
  open(){return this.db||(this.db=new Promise((res,rej)=>{const r=indexedDB.open("vouz-photos",1);r.onupgradeneeded=()=>r.result.createObjectStore("p");r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)}))},
  async tx(mode,f){const db=await this.open();return new Promise((res,rej)=>{const t=db.transaction("p",mode),r=f(t.objectStore("p"));t.oncomplete=()=>res(r&&r.result);t.onerror=()=>rej(t.error)})},
  put(id,blob){return this.tx("readwrite",st=>st.put(blob,id))},
  get(id){return this.tx("readonly",st=>st.get(id))},
  del(id){const u=this.urls.get(id);if(u){URL.revokeObjectURL(u);this.urls.delete(id)}return this.tx("readwrite",st=>st.delete(id)).catch(()=>{})},
  clear(){this.urls.forEach(u=>URL.revokeObjectURL(u));this.urls.clear();return this.ok?this.tx("readwrite",st=>st.clear()).catch(()=>{}):Promise.resolve()},
  async url(id){if(this.urls.has(id))return this.urls.get(id);const b=await this.get(id);if(!b)return null;const u=URL.createObjectURL(b);this.urls.set(id,u);return u}};
/* Drawing onto a canvas and re-encoding drops EXIF data, including any GPS position the camera wrote. */
async function shrink(file){const bmp=await createImageBitmap(file),k=Math.min(1,1600/Math.max(bmp.width,bmp.height)),c=document.createElement("canvas");
  c.width=Math.max(1,Math.round(bmp.width*k));c.height=Math.max(1,Math.round(bmp.height*k));c.getContext("2d").drawImage(bmp,0,0,c.width,c.height);if(bmp.close)bmp.close();
  return new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error("encode")),"image/jpeg",.85))}
function hydratePhotos(){document.querySelectorAll("img[data-photo]:not([src])").forEach(async im=>{const u=await Photos.url(im.dataset.photo).catch(()=>null);if(u)im.src=u;else{im.alt="Photo not on this device";im.closest(".ph")&&im.closest(".ph").classList.add("gone")}})}

/* ---- what one experience looks like to the other people in a space: never private notes or photos ---- */
const shareX=e=>({id:e.id,kind:e.kind,title:e.title,date:e.date,cat:e.cat,location:e.location||"",sharedNote:e.sharedNote||"",mood:e.mood||"",favorite:e.favorite||"",idea:e.idea||null,anniv:!!e.anniv,updatedAt:e.updatedAt});
function sanX(b,a,sp){if(!b||typeof b.id!=="string"||!["done","plan"].includes(b.kind))return null;const str=(v,n)=>typeof v==="string"?v.slice(0,n):"";
  return{id:b.id,a,sp,kind:b.kind,title:str(b.title,80)||"Untitled",date:typeof b.date==="number"&&isFinite(b.date)?b.date:null,cat:XCATS[b.cat]?b.cat:"other",location:str(b.location,80),sharedNote:str(b.sharedNote,500),mood:MC[b.mood]?b.mood:"",favorite:str(b.favorite,200),idea:IDEA[b.idea]?b.idea:null,anniv:!!b.anniv,updatedAt:+b.updatedAt||0,photos:[]}}

Object.assign(Soc,{sp:{},shared:[],picks:{},accRaw:[],pubSig:"",
  async open(key,c){const k="o"+c;if(k in this.cache)return this.cache[k];return this.cache[k]=await K.decJ(key,c)},
  /* A space: a random key, wrapped for the owner and for each person invited, plus an encrypted description.
     Only people holding the key can read the space's name, its member list, and anything shared into it. */
  async sealSpace(body,raw){raw=raw||crypto.getRandomValues(new Uint8Array(32));const key=await K.aes(raw),wk={self:await K.enc(K.self,raw)};
    for(const u of body.members.concat(body.invited)){const r=this.rel[u];if(r&&r.mutual)wk[r.out]=await K.enc(r.key,raw)}
    return{id:body.id,c:await K.encJ(key,body),wk}},
  async readSpaces(){const me=Cloud.uid,sp={},acc={},accRaw=[];
    for(const x of ((this.spaces[me]||{}).acc||[])){if(!x)continue;let hit=null;
      for(const id in this.rel){const r=this.rel[id];if(x.k!==r.out)continue;try{const b=await this.open(r.key,x.c);if(b&&b.id){hit={id:b.id,ok:!!b.ok,owner:id}}}catch(e){}}
      accRaw.push({...x,id:hit&&hit.id});if(hit)acc[hit.id]=hit}
    this.accRaw=accRaw;
    for(const owner in this.spaces){if(owner!==me&&(!this.rel[owner]||!this.rel[owner].mutual||S.blocks.includes(owner)))continue;
      for(const it of (this.spaces[owner].items||[])){if(!it||!it.wk)continue;const w=owner===me?it.wk.self:it.wk[this.rel[owner].in];if(!w)continue;
        try{const ck="s"+it.c+w;let e=this.cache[ck];if(!e){const raw=await K.dec(owner===me?K.self:this.rel[owner].key,w),key=await K.aes(raw);
            e=this.cache[ck]={raw,key,body:await K.decJ(key,it.c),tag:hex(await crypto.subtle.digest("SHA-256",cat(raw,"|vouz-space"))).slice(0,24)}}
          const b=e.body;if(b.id!==it.id||b.owner!==owner)continue;const a=acc[b.id];
          const role=owner===me?"owner":a&&!a.ok?null:(b.members||[]).includes(me)?"member":a&&a.ok?"joining":(b.invited||[]).includes(me)?"invited":null;
          if(role)sp[b.id]={id:b.id,name:String(b.name||"Our space").slice(0,40),owner,members:(b.members||[]).filter(u=>u!==owner),invited:(b.invited||[]).filter(u=>u!==owner),key:e.key,raw:e.raw,tag:e.tag,role,v:+b.v||1,item:it}}catch(x){}}}
    this.sp=sp;
    const shared=[],picks={};
    for(const x of Object.values(sp)){if(x.role==="invited")continue;picks[x.id]={};
      for(const u of [x.owner,...x.members]){if(S.blocks.includes(u))continue;
        for(const it of ((this.match[u]||{}).items||[]))if(it&&it.t===x.tag){try{const b=await this.open(x.key,it.c);if(Array.isArray(b.picks))picks[x.id][u]=b.picks.filter(p=>IDEA[p])}catch(e){}}
        if(u===me)continue;
        for(const it of ((this.exps[u]||{}).items||[]))if(it&&it.t===x.tag){try{const v=sanX(await this.open(x.key,it.c),u,x.id);if(v)shared.push(v)}catch(e){}}}}
    this.shared=shared;this.picks=picks;
    await this.reconcileSpaces();await this.publishMine()},
  async answerFrom(u,id){const r=this.rel[u];if(!r)return null;let out=null;
    for(const x of ((this.spaces[u]||{}).acc||[])){if(!x||x.k!==r.in)continue;try{const b=await this.open(r.key,x.c);if(b&&b.id===id)out=!!b.ok}catch(e){}}return out},
  /* Owner only: move people who accepted into the member list, and drop anyone who declined, left, disconnected or was blocked.
     Anyone dropped held the key, so the space gets a new one. */
  async reconcileSpaces(){const me=Cloud.uid,cur=this.spaces[me];if(!cur||!cur.items||this.recSp)return;let changed=false;const items=[];
    for(const it of cur.items){const x=Object.values(this.sp).find(s=>s.item===it&&s.role==="owner");if(!x){items.push(it);continue}
      let members=x.members.slice(),invited=x.invited.slice();const drop=[];
      for(const u of members.concat(invited)){const r=this.rel[u];if(!r||!r.mutual||S.blocks.includes(u)){drop.push(u);continue}
        const a=await this.answerFrom(u,x.id);if(a===false)drop.push(u);else if(a===true&&invited.includes(u)){invited=invited.filter(v=>v!==u);members.push(u)}}
      members=members.filter(u=>!drop.includes(u));invited=invited.filter(u=>!drop.includes(u));
      if(drop.length||members.length!==x.members.length){changed=true;items.push(await this.sealSpace({id:x.id,name:x.name,owner:me,members,invited,v:x.v+(drop.length?1:0)},drop.length?null:x.raw))}else items.push(it)}
    if(changed){this.recSp=true;try{await this.write("spaces",{items,acc:cur.acc||[]})}finally{this.recSp=false}}},
  /* My shared experiences and Mutual Match picks are rebuilt from this device's records under each space's current key. */
  async publishMine(){const me=Cloud.uid,inSp=Object.values(this.sp).filter(x=>x.role!=="invited");
    const sig=JSON.stringify([inSp.map(x=>x.tag),S.exps.filter(e=>!e.demo&&e.space).map(e=>[e.id,e.space,e.updatedAt]),inSp.map(x=>[x.id,S.picks[x.id]||null])]);
    if(sig===this.pubSig)return;this.pubSig=sig;const ex=[],pk=[];
    for(const x of inSp){for(const e of S.exps.filter(e=>!e.demo&&e.space===x.id))ex.push({t:x.tag,c:await K.encJ(x.key,shareX(e))});
      if(Array.isArray(S.picks[x.id]))pk.push({t:x.tag,c:await K.encJ(x.key,{picks:S.picks[x.id]})})}
    if(ex.length||((this.exps[me]||{}).items||[]).length)await this.write("exps",{items:ex});
    if(pk.length||((this.match[me]||{}).items||[]).length)await this.write("match",{items:pk})},
  async answerSpace(x,ok){const r=this.rel[x.owner];if(!r)throw 0;const cur=this.spaces[Cloud.uid]||{};
    const keep=(cur.acc||[]).filter(a=>{const raw=this.accRaw.find(z=>z.c===a.c);return!(raw&&raw.id===x.id)});
    keep.push({k:r.out,c:await K.encJ(r.key,{id:x.id,ok})});
    await this.write("spaces",{items:cur.items||[],acc:keep})},
  async saveSpaces(items){const cur=this.spaces[Cloud.uid]||{};await this.write("spaces",{items,acc:cur.acc||[]})},
  inSpaces(){return Object.values(this.sp).filter(x=>x.role!=="invited")},
  spaceName(id){const x=this.sp[id];return x?x.name:null},
  people(x){return [x.owner,...x.members].filter((u,i,a)=>a.indexOf(u)===i)}
});

/* Mutual Match: an idea is shown only when every member of the space has picked it. */
function matchFor(x){const me=Cloud.uid,ppl=Soc.people(x);if(!ppl.includes(me))ppl.push(me);const p=Soc.picks[x.id]||{},mine=S.picks[x.id];
  const has=u=>u===me?Array.isArray(mine):Array.isArray(p[u]),waiting=ppl.filter(u=>!has(u)),sets=ppl.map(u=>new Set(u===me?mine||[]:p[u]||[]));
  return{ppl,waiting,matches:waiting.length||ppl.length<2?[]:IDEAS.filter(i=>sets.every(st=>st.has(i.id)))}}

/* Everything for the timeline and plans: my own records plus what people shared into spaces I'm in. */
function allExps(){const mine=S.exps.map(e=>({...e,a:"me",sp:e.space&&Soc.sp[e.space]&&Soc.sp[e.space].role!=="invited"?e.space:null}));
  const theirs=S.settings.social?Soc.shared.filter(x=>Soc.sp[x.sp]):[];return mine.concat(theirs)}
const storyItems=f=>allExps().filter(e=>e.kind==="done"&&(f==="all"||(f==="mine"?e.a==="me"&&!e.sp:e.sp===f))).sort((a,b)=>(b.date||0)-(a.date||0));
const allPlans=()=>allExps().filter(e=>e.kind==="plan").sort((a,b)=>(a.date||9e15)-(b.date||9e15));
const whoX=e=>e.a==="me"?"":Soc.handle(e.a);
function nextAnniv(e,now=Date.now()){const d=new Date(e.date),t=new Date(new Date(now).getFullYear(),d.getMonth(),d.getDate()).getTime();const n=t>=startOfDay(now)?t:new Date(new Date(now).getFullYear()+1,d.getMonth(),d.getDate()).getTime();return{at:n,years:new Date(n).getFullYear()-d.getFullYear(),days:Math.round((n-startOfDay(now))/DAY)}}

/* ---------------- views ---------------- */
function vIntimacy(){const seg=ui.int.seg,bar=`<div><h3>Intimacy</h3></div><div class="seg3" role="group" aria-label="Intimacy section">${[["track","Track"],["history","History"],["insights","Insights"]].map(([v,l])=>`<button data-act="iSeg" data-v="${v}" aria-pressed="${seg===v}">${l}</button>`).join("")}</div>`;
  const h=seg==="insights"?vInsights():seg==="history"?vHistList():vTrack();return h.replace('<div class="scroll">','<div class="scroll">'+bar)}

function vHistList(){const all=sessions(),st=stats(all),ws=startOfWeek(Date.now()),cd=countByDay(all),todayI=(new Date().getDay()+6)%7,sel=ui.homeDay===null?todayI:ui.homeDay;
  if(!all.length)return`<div class="scroll">${demoBanner()}<div class="card"><h2>Nothing logged yet.</h2><p class="sub">This fills in from what you save, and only from that.</p><div class="row wrap"><button class="btn sm primary" data-act="quick">${ic("plus")} Quick log</button><button class="btn sm" data-act="manual">Log a past session</button><button class="btn sm ghost" data-act="loadDemo">See it with demo data</button></div></div></div>`;
  const dayT=addDays(ws,sel),dayS=all.filter(s=>dayKey(s.start)===dayKey(dayT)),wk=all.filter(s=>s.start>=ws),wst=stats(wk);
  const now=new Date(),y=now.getFullYear(),m=now.getMonth(),first=new Date(y,m,1),lead=(first.getDay()+6)%7,dim=new Date(y,m+1,0).getDate(),today=dayKey(Date.now());
  let cal="MTWTFSS".split("").map(c=>`<span class="h">${c}</span>`).join("")+"<span></span>".repeat(lead);
  for(let d=1;d<=dim;d++){const k=y+"-"+pad(m+1)+"-"+pad(d),c=cd[k]||0;cal+=`<span class="${c>1?"on2":c?"on":""}${k===today?" today":""}" title="${c} session${c===1?"":"s"}">${d}</span>`}
  const ach=achievements(),got=ach.filter(a=>a.at).sort((a,b)=>b.at.start-a.at.start),rest=ach.filter(a=>!a.at);
  return`<div class="scroll">${demoBanner()}<div class="stage" style="max-width:250px">${weekRing(ws,cd,sel)}<div class="in"><b style="font-family:var(--display);font-size:44px;font-weight:400" data-count="${wst.n}">${wst.n}</b><span class="sub small">this week</span></div></div>
   <div class="sec" aria-live="polite"><div class="row between"><h3>${sel===todayI?"Today":fmtDate(dayT)}</h3><span class="sub small">This week: ${fmtDur(wst.tot)}</span></div>${dayS.length?`<div>${dayS.map(sessRow).join("")}</div>`:`<p class="sub small">${dayT>Date.now()?"Still ahead.":"Nothing logged for this day."} Tap a day on the ring to look at another.</p>`}</div>
   <div class="trio"><div><b data-count="${st.n}">${st.n}</b><span>sessions</span></div><div><b data-count="${fmtMin(st.tot)}">${fmtMin(st.tot)}</b><span>minutes</span></div><div><b data-count="${fmtMin(st.avg)}">${fmtMin(st.avg)}</b><span>avg minutes</span></div></div>
   <div class="card"><div class="row between"><h3>${MO[m]} ${y}</h3><span class="sub small">${Object.keys(cd).filter(k=>k.startsWith(y+"-"+pad(m+1))).length} active days</span></div><div class="cal">${cal}</div></div>
   <div class="sec"><div class="row between"><h3>All sessions</h3><button class="link small" data-act="manual">${ic("plus")} Log one</button></div><div>${all.map(sessRow).join("")}</div></div>
   <div class="sec"><div class="row between"><h3>Achievements</h3><button class="link small" data-act="page" data-page="achievements">${got.length} of ${ach.length}</button></div><div class="hs">${got.concat(rest).map(a=>`<div class="b ${a.at?"on":""}"><span class="badge ${a.at?"on":""}">${a.g}</span>${a.name}</div>`).join("")}</div><p class="tiny">Private to you unless you choose to share one.</p></div></div>`}

function spaceInvitesCard(){if(!S.settings.social)return"";const inv=Object.values(Soc.sp).filter(x=>x.role==="invited");if(!inv.length)return"";
  return`<div class="card line" role="region" aria-label="Space invitations"><h3>Shared space invitations</h3><div>${inv.map(x=>`<div class="col" style="gap:8px;padding:8px 0"><span><b>${esc(Soc.handle(x.owner))}</b> invited you to <b>${esc(x.name)}</b><span class="sub small" style="display:block">With ${esc(names(Soc.people(x).concat(x.invited).filter(u=>u!==Cloud.uid&&u!==x.owner))||"just the two of you")}</span></span><div class="row"><button class="btn sm primary grow" data-act="spAccept" data-id="${esc(x.id)}">Join</button><button class="btn sm ghost grow" data-act="spDecline" data-id="${esc(x.id)}">Decline</button></div></div>`).join("")}</div><p class="tiny">Members see what each person chooses to share into the space: memories, plans and Mutual Match results. Never private notes, photos or intimacy records.</p></div>`}

function planRow(e){const mine=e.a==="me",it=e.idea?IDEA[e.idea]:null;
  return`<div class="ach"><span class="badge on" aria-hidden="true">${ic("compass")}</span><span class="grow"><b>${esc(e.title)}</b><span class="sub small" style="display:block">${e.date?fmtDate(e.date)+(new Date(e.date).getHours()||new Date(e.date).getMinutes()?" · "+fmtTime(e.date):""):"Not scheduled"}${e.sp?" · "+esc(Soc.spaceName(e.sp)):" · Just you"}${mine?"":" · planned by "+esc(whoX(e))}</span>${it&&!mine?"":""}</span>
   ${mine?`<span class="row" style="gap:6px"><button class="btn sm ghost" data-act="planSched" data-id="${e.id}" aria-label="Schedule ${esc(e.title)}">${ic("clock")}</button><button class="btn sm" data-act="planDone" data-id="${e.id}" aria-label="Mark ${esc(e.title)} done">${ic("check")}</button></span>`:""}</div>`}

function ideaCard(x,extra=""){const planned=S.exps.some(e=>e.kind==="plan"&&e.idea===x.id);
  return`<div class="card idea"><div><b class="it">${esc(x.t)}</b><p class="sub small">${esc(x.d)}</p><p class="tiny">${ideaMeta(x)}</p></div>${extra||`<button class="btn sm ${planned?"ghost":""}" style="align-self:flex-start" data-act="ideaSave" data-v="${x.id}" ${planned?"disabled":""}>${planned?ic("check")+" In your plans":ic("plus")+" Save to plans"}</button>`}</div>`}

function suggestion(){const used=new Set(S.exps.map(e=>e.idea).filter(Boolean)),pool=IDEAS.filter(x=>!used.has(x.id));if(!pool.length)return null;
  return pool[(Math.floor(Date.now()/DAY)+(ui.sugOff||0))%pool.length]}

function vHome(){const h=new Date().getHours(),greet=h<5?"Up late":h<12?"Morning":h<18?"Afternoon":"Evening";
  const head=`<div class="row between"><div class="mark">vouz<b>.</b></div><button class="pill" data-act="tab" data-tab="profile" aria-label="Privacy settings">${ic("lock")} Private</button></div>`;
  const plans=allPlans().slice(0,3),mem=storyItems("all").slice(0,2),ws=startOfWeek(Date.now()),wk=S.sessions.filter(s=>s.start>=ws),sug=suggestion();
  const live=S.active?`<button class="card rowcard" data-act="tab" data-tab="track" aria-label="Return to your running session"><span class="badge on" aria-hidden="true">${ic(running()?"pause":"play")}</span><span class="grow"><b>Session ${running()?"running":"paused"}</b><span class="sub small" style="display:block" id="miniclock">${fmtClock(elapsed(S.active))}</span></span>${ic("next")}</button>`
    :S.draft&&S.draft.fromTimer?`<button class="card rowcard" data-act="resumeDraft"><span class="badge on" aria-hidden="true">${ic("edit")}</span><span class="grow"><b>Finish saving your session</b></span>${ic("next")}</button>`:"";
  return`<div class="scroll">${head}${demoBanner()}${invitesCard()}${spaceInvitesCard()}
   <div><h1>${greet}${S.user.name?", "+esc(S.user.name):""}.</h1><p class="sub">Less scrolling. More together.</p></div>${live}
   <div class="qa"><button data-act="quick">${ic("heart")}<span>Quick log</span></button><button data-act="expNew" data-kind="done">${ic("book")}<span>Add a memory</span></button><button data-act="tab" data-tab="discover">${ic("compass")}<span>Find an idea</span></button></div>
   <div class="sec"><div class="row between"><h3>Coming up</h3><button class="link small" data-act="discSeg" data-v="plans">All plans</button></div>${plans.length?`<div>${plans.map(planRow).join("")}</div>`:`<p class="sub small">Nothing planned. Save an idea from Discover, or one you match on together.</p>`}</div>
   ${sug?`<div class="sec"><div class="row between"><h3>An idea</h3><button class="link small" data-act="sugNext">Something else</button></div>${ideaCard(sug)}</div>`:""}
   <div class="sec"><div class="row between"><h3>Recent memories</h3><button class="link small" data-act="tab" data-tab="story">Our Story</button></div>${mem.length?`<div>${mem.map(storyRow).join("")}</div>`:`<p class="sub small">Nothing here yet. Add a dinner, a trip, a milestone: anything worth keeping.</p>`}</div>
   <button class="card rowcard" data-act="tab" data-tab="history"><span class="badge" aria-hidden="true">${ic("heart")}</span><span class="grow"><b>Intimacy this week</b><span class="sub small" style="display:block">${wk.length?wk.length+" session"+(wk.length===1?"":"s")+", "+fmtDur(stats(wk).tot):"Nothing logged this week"} · only you see this</span></span>${ic("next")}</button>
   ${!S.sessions.length&&!S.exps.length?`<div class="sec" style="text-align:center;align-items:center"><p class="sub small">Everything here starts empty and fills in from what you add.</p><button class="btn sm ghost" data-act="loadDemo">See it with demo data</button></div>`:""}</div>`}

function storyRow(e){const t=new Date(e.date||0);return`<button class="sess" data-act="expOpen" data-id="${esc(e.id)}" data-a="${esc(e.a)}">${e.photos&&e.photos[0]?`<span class="ph sm"><img data-photo="${esc(e.photos[0])}" alt=""></span>`:`<span class="d"><b>${t.getDate()}</b><span>${MO[t.getMonth()]}</span></span>`}<span class="grow"><span class="t" style="display:block">${esc(e.title)}</span><span class="sub small">${XCATS[e.cat]||"Other"}${e.location?" · "+esc(e.location):""}${e.a!=="me"?" · from "+esc(whoX(e)):e.sp?" · "+esc(Soc.spaceName(e.sp)):" · private"}${e.demo?" · demo":""}</span></span></button>`}

function vStory(){const f=ui.story.space,sps=Soc.inSpaces(),items=storyItems(f),now=Date.now();
  const ann=allExps().filter(e=>e.kind==="done"&&e.anniv&&e.date).map(e=>({e,n:nextAnniv(e)})).filter(x=>x.n.days<=60&&x.n.years>0).sort((a,b)=>a.n.days-b.n.days);
  const groups=[];items.forEach(e=>{const d=new Date(e.date),k=d.getFullYear()+"-"+d.getMonth();const g=groups[groups.length-1];if(g&&g.k===k)g.items.push(e);else groups.push({k,l:MO[d.getMonth()]+" "+d.getFullYear(),items:[e]})});
  return`<div class="scroll"><div class="row between"><div><h3>Our Story</h3><h1>The parts <em>worth keeping.</em></h1></div></div>${demoBanner()}
   <button class="btn primary block" data-act="expNew" data-kind="done">${ic("plus")} Add a memory</button>
   ${sps.length?`<div class="chips" role="group" aria-label="Show">${[["all","Everything"],["mine","Private"]].concat(sps.map(x=>[x.id,x.name])).map(([v,l])=>`<button class="chip" data-act="storyFilter" data-v="${esc(v)}" aria-pressed="${f===v}">${esc(l)}</button>`).join("")}</div>`:""}
   ${ann.length?`<div class="card line"><h3>Coming up</h3>${ann.map(({e,n})=>`<p><b>${esc(e.title)}</b>: ${n.years===1?"first":n.years+ordinal(n.years)} anniversary ${n.days===0?"today":n.days===1?"tomorrow":"in "+n.days+" days"}, ${fmtDate(n.at)}.</p>`).join("")}</div>`:""}
   ${groups.length?groups.map(g=>`<div class="sec"><h3>${g.l}</h3><div>${g.items.map(storyRow).join("")}</div></div>`).join(""):`<div class="card"><h2>${f==="all"?"Your story starts here.":"Nothing here yet."}</h2><p class="sub">Dinners, trips, small wins, big milestones. Each one is private unless you put it in a shared space.</p>${S.exps.length?"":`<button class="btn sm ghost" style="align-self:flex-start" data-act="loadDemo">See it with demo data</button>`}</div>`}</div>`}
const ordinal=n=>{const t=n%100;return t>=11&&t<=13?"th":({1:"st",2:"nd",3:"rd"})[n%10]||"th"};

function findX(id,a){return a==="me"||!a?S.exps.find(e=>e.id===id):Soc.shared.find(e=>e.id===id&&e.a===a)}
function vExp(){const p=ui.page,e=findX(p.id,p.a);if(!e){ui.page=null;return vStory()+vTabs()}const mine=!p.a||p.a==="me";const sp=mine?(e.space&&Soc.sp[e.space]?Soc.sp[e.space]:null):Soc.sp[e.sp];
  return hdr(e.kind==="plan"?"Plan":"Memory",mine?`<button class="ib" data-act="expEdit" data-id="${e.id}" aria-label="Edit">${ic("edit")}</button>`:"")+`<div class="scroll">
   <div><h3>${e.date?fmtDate(e.date)+" "+new Date(e.date).getFullYear():"Not scheduled"} · ${XCATS[e.cat]||"Other"}</h3><h1>${esc(e.title)}</h1>${e.location?`<p class="sub">${esc(e.location)}</p>`:""}</div>
   ${mine&&e.photos&&e.photos.length?`<div class="phs">${e.photos.map(id=>`<span class="ph"><img data-photo="${esc(id)}" alt="Photo from ${esc(e.title)}"></span>`).join("")}</div><p class="tiny">Photos are kept on this device only.</p>`:""}
   ${e.favorite?`<div class="card"><h3>Favorite moment</h3><p style="font-family:var(--display);font-size:22px;line-height:1.25;overflow-wrap:anywhere">${esc(e.favorite)}</p></div>`:""}
   ${e.mood?`<p><span class="pill" style="color:${MC[e.mood]||"var(--muted)"}">${esc(e.mood)}</span></p>`:""}
   ${e.sharedNote?`<div class="card"><h3>Shared note</h3><p style="overflow-wrap:anywhere">${esc(e.sharedNote)}</p></div>`:""}
   ${mine&&e.notes?`<div class="card line"><h3>Private notes</h3><p style="white-space:pre-wrap;overflow-wrap:anywhere">${esc(e.notes)}</p><p class="tiny">Only you see these.</p></div>`:""}
   <p class="tiny">${mine?(sp?"Shared with "+esc(sp.name)+": "+esc(names(Soc.people(sp).filter(u=>u!==Cloud.uid))||"no one else yet")+". Private notes and photos stay with you.":e.space?"Private: the space this was shared to has ended.":"Private: only you see this."):"Shared by "+esc(Soc.handle(e.a))+" in "+esc(sp?sp.name:"a space")+"."}</p>
   ${mine&&e.kind==="plan"?`<div class="row"><button class="btn grow" data-act="planSched" data-id="${e.id}">${ic("clock")} Schedule</button><button class="btn primary grow" data-act="planDone" data-id="${e.id}">${ic("check")} Mark done</button></div>`:""}
   ${mine?`<button class="btn danger block" data-act="expDelAsk" data-id="${e.id}">${ic("trash")} Delete</button>`:""}</div>`}

function vExpEdit(){const d=ui.xd;if(!d){ui.page=null;return vStory()+vTabs()}const sps=Soc.inSpaces();
  return hdr(d.editing?"Edit":d.kind==="plan"?"New plan":"New memory")+`<div class="scroll">
   <label class="f" for="x-title">What was it?<input type="text" id="x-title" data-bind="xd.title" maxlength="80" value="${esc(d.title)}" placeholder="${d.kind==="plan"?"Something to do together":"Dinner at the place by the water"}" autocomplete="off"></label>
   <label class="f" for="x-date">${d.kind==="plan"?"When <em>Optional</em>":"Date"}<input type="date" id="x-date" data-bind="xd.date" value="${esc(d.date)}" ${d.kind==="plan"?"":`max="${dayKey(Date.now())}"`}></label>
   <div class="col"><h3>Kind</h3><div class="chips" role="group" aria-label="Kind">${Object.entries(XCATS).map(([k,l])=>`<button class="chip" data-act="xCat" data-v="${k}" aria-pressed="${d.cat===k}">${l}</button>`).join("")}</div></div>
   ${d.cat==="milestone"?sw("xAnniv",d.anniv,"Remember the anniversary","Our Story reminds you as the date comes round."):""}
   <label class="f" for="x-loc">Place <em>Optional. Typed by you; VOUZ never reads your location.</em><input type="text" id="x-loc" data-bind="xd.location" maxlength="80" value="${esc(d.location)}" autocomplete="off"></label>
   ${d.kind==="done"?`<label class="f" for="x-fav">Favorite moment <em>Optional</em><input type="text" id="x-fav" data-bind="xd.favorite" maxlength="200" value="${esc(d.favorite)}" autocomplete="off"></label>
   <div class="col"><h3>Mood <span class="tiny" style="text-transform:none;letter-spacing:0">Optional</span></h3><div class="chips">${MOODS.map(m=>`<button class="chip" data-act="xMood" data-v="${m}" aria-pressed="${d.mood===m}">${m}</button>`).join("")}</div></div>
   <div class="col"><h3>Photos <span class="tiny" style="text-transform:none;letter-spacing:0">Optional, this device only</span></h3>${d.photos.length?`<div class="phs">${d.photos.map(id=>`<span class="ph"><img data-photo="${esc(id)}" alt="Photo"><button class="ib" data-act="xPhotoDel" data-id="${esc(id)}" aria-label="Remove photo">${ic("x")}</button></span>`).join("")}</div>`:""}
     ${Photos.ok?(d.photos.length<6?`<label class="btn sm" style="align-self:flex-start" for="x-photo">${ic("photo")} Add photos<input type="file" id="x-photo" accept="image/*" multiple class="vh"></label>`:`<p class="tiny">Six photos per memory.</p>`):`<p class="tiny">This browser can't keep photos.</p>`}
     <p class="tiny">Photos stay on this device. They're re-saved without location data, aren't synced or exported, and nobody else sees them.</p></div>`:""}
   <label class="f" for="x-notes">Private notes <em>Optional. Never shared.</em><textarea id="x-notes" data-bind="xd.notes" maxlength="2000">${esc(d.notes)}</textarea></label>
   <div class="col"><h3>Who can see it</h3><div class="chips" role="group" aria-label="Who can see it"><button class="chip" data-act="xSpace" data-v="" aria-pressed="${!d.space}">${ic("lock")} Just me</button>${sps.map(x=>`<button class="chip" data-act="xSpace" data-v="${esc(x.id)}" aria-pressed="${d.space===x.id}">${esc(x.name)}</button>`).join("")}</div>
     ${d.space?`<label class="f" for="x-shared">Shared note <em>Optional. Visible to the space.</em><textarea id="x-shared" data-bind="xd.sharedNote" maxlength="500">${esc(d.sharedNote)}</textarea></label><p class="tiny">The space sees the title, date, kind, place, favorite moment, mood and shared note. Not your private notes or photos.</p>`:sps.length?"":`<p class="tiny">To share with a partner, turn on Connections in Profile and create a shared space.</p>`}</div>
   ${ui.err?`<p class="err" role="alert">${esc(ui.err)}</p>`:""}
   <button class="btn primary block" data-act="expSave">${d.editing?"Save changes":"Save"}</button></div>`}

function vDiscover(){const seg=ui.disc.seg,f=ui.disc.f;
  const head=`<div><h3>Discover</h3><h1>Something to <em>do together.</em></h1></div><div class="seg3" role="group" aria-label="Discover section">${[["ideas","Ideas"],["match","Mutual Match"],["plans","Plans"]].map(([v,l])=>`<button data-act="discSeg" data-v="${v}" aria-pressed="${seg===v}">${l}</button>`).join("")}</div>`;
  const chipRow=(k,label,opts)=>`<div class="col" style="gap:6px"><span class="tiny">${label}</span><div class="chips sm" role="group" aria-label="${label}">${opts.map(([v,l])=>`<button class="chip" data-act="fSet" data-k="${k}" data-v="${v}" aria-pressed="${String(f[k]??"")===String(v)}">${l}</button>`).join("")}</div></div>`;
  const filters=`<details class="card filt" ${ui.disc.open?"open":""}><summary data-act="fOpen"><b>Filters</b><span class="sub small">${IDEAS.filter(x=>ideaOk(x,f)).length} of ${IDEAS.length}</span></summary>
    ${chipRow("b","Budget",[["","Any"],["0","Free"],["1","Up to $"],["2","Up to $$"]])}${chipRow("tm","Time you have",[["","Any"],["1","An hour"],["2","A few hours"],["3","Half a day"]])}
    ${chipRow("ds","Distance",[["","Any"],["home","At home"],["near","Nearby"],["day","Day trip"],["away","Travel"]])}${chipRow("w","Setting",[["","Either"],["in","Indoors"],["out","Outdoors"]])}${chipRow("e","Energy",[["","Any"],["1","Low"],["2","Some"],["3","High"]])}
    <div class="col" style="gap:6px"><span class="tiny">Interests</span><div class="chips sm">${Object.entries(INTS).map(([k,l])=>`<button class="chip" data-act="fInt" data-v="${k}" aria-pressed="${(f.g||[]).includes(k)}">${l}</button>`).join("")}</div></div>
    <button class="link small" data-act="fClear">Clear filters</button></details>`;
  let body="";
  if(seg==="ideas"){const list=IDEAS.filter(x=>ideaOk(x,f));body=filters+(list.length?list.map(x=>ideaCard(x)).join(""):`<div class="card line"><p class="sub small">Nothing fits all of those. Loosen a filter.</p></div>`)}
  else if(seg==="plans"){const pl=allPlans();body=`<button class="btn block" data-act="expNew" data-kind="plan">${ic("plus")} New plan</button>`+(pl.length?`<div class="sec"><div>${pl.map(planRow).join("")}</div></div><p class="tiny">Tap ${ic("clock").replace('class="i"','class="i" style="width:12px;height:12px;vertical-align:-1px"')} to schedule, ${ic("check").replace('class="i"','class="i" style="width:12px;height:12px;vertical-align:-1px"')} when it's done: it moves to Our Story.</p>`:`<div class="card line"><p class="sub small">No plans yet. Save an idea, or one you match on.</p></div>`)}
  else{if(!Soc.ready())body=`<div class="card"><h2>Pick privately. <em>Match together.</em></h2><p class="sub">Each of you chooses what you'd like to do, without seeing the other's choices. VOUZ shows only what everyone picked.</p><p class="sub small">${S.settings.social?"Connections can't be reached right now.":"This needs Connections, which is off. Turn it on in Profile, connect with your partner, and create a shared space."}</p><button class="btn sm" style="align-self:flex-start" data-act="tab" data-tab="profile">Profile</button></div>`;
    else{const sps=Soc.inSpaces();if(!sps.length)body=`<div class="card"><h2>Start a shared space.</h2><p class="sub">Mutual Match happens inside a space you share with a partner, or with everyone in a relationship who agrees to join.</p><button class="btn sm primary" style="align-self:flex-start" data-act="page" data-page="spaces">Shared spaces</button></div>`;
      else{const x=Soc.sp[ui.disc.space]&&Soc.sp[ui.disc.space].role!=="invited"?Soc.sp[ui.disc.space]:sps[0];ui.disc.space=x.id;const m=matchFor(x),mine=new Set(S.picks[x.id]||[]),list=IDEAS.filter(i=>ideaOk(i,f));
        body=`${sps.length>1?`<div class="chips" role="group" aria-label="Space">${sps.map(s=>`<button class="chip" data-act="pickSpace" data-v="${esc(s.id)}" aria-pressed="${s.id===x.id}">${esc(s.name)}</button>`).join("")}</div>`:""}
         <div class="card"><div class="row between"><h3>${esc(x.name)}</h3><span class="pill">${m.ppl.length} ${m.ppl.length===1?"person":"people"}</span></div><p class="sub small">Matching between ${esc(names(m.ppl.map(u=>u===Cloud.uid?"you":u)))}. An idea appears only when every one of you picked it.</p>
          ${m.ppl.length<2?`<p class="sub small">Nobody else has joined yet.</p>`:m.waiting.length?`<p class="sub small">Waiting for ${esc(names(m.waiting.map(u=>u===Cloud.uid?"you":u)))} to pick.</p>`:m.matches.length?`<h3 style="margin-top:6px">You matched on ${m.matches.length}</h3>`:`<p class="sub small">No matches yet. Pick a few more, or come back after the others do.</p>`}</div>
         ${m.matches.map(i=>ideaCard(i,(()=>{const done=S.exps.some(e=>e.idea===i.id&&e.space===x.id);return`<button class="btn sm primary" style="align-self:flex-start" data-act="matchSave" data-v="${i.id}" ${done?"disabled":""}>${done?ic("check")+" Planned":ic("plus")+" Plan it together"}</button>`})())).join("")}
         <div class="sec"><div class="row between"><h3>Your picks</h3><span class="sub small">${mine.size} chosen</span></div><p class="tiny">Only you see this list. Nobody sees what you picked unless they picked it too.</p>${filters}<div>${list.map(i=>`<button class="pick" data-act="pickToggle" data-v="${i.id}" aria-pressed="${mine.has(i.id)}"><span class="grow"><b>${esc(i.t)}</b><span class="sub small" style="display:block">${ideaMeta(i)}</span></span><span class="tick" aria-hidden="true">${ic(mine.has(i.id)?"check":"plus")}</span></button>`).join("")}</div></div>`}}}
  return`<div class="scroll">${head}${body}</div>`}

function vSpaces(){const ready=Soc.ready();
  if(!ready)return hdr("Shared spaces")+`<div class="scroll"><div class="card"><h2>Shared with the people <em>you choose.</em></h2><p class="sub">A shared space is where a partner, or everyone in a relationship who agrees to join, can see the memories and plans each person puts there, and use Mutual Match.</p><p class="sub small">${S.settings.social?"Connections can't be reached right now.":"Turn on Connections in Profile first."}</p></div></div>`;
  const all=Object.values(Soc.sp),mine=all.filter(x=>x.role!=="invited"),conns=Soc.conns(),pick=ui.spPick||[];
  const card=x=>{const owner=x.role==="owner";return`<div class="card"><div class="row between"><h2>${esc(x.name)}</h2><span class="pill">${owner?"You created it":"Created by "+esc(Soc.handle(x.owner))}</span></div>
    <div>${[x.owner,...x.members,...x.invited].filter((u,i,a)=>a.indexOf(u)===i).map(u=>`<div class="ach"><span class="av" aria-hidden="true">${esc((u===Cloud.uid?"you":Soc.handle(u))[0].toUpperCase())}</span><span class="grow"><b>${u===Cloud.uid?"You":esc(Soc.handle(u))}</b><span class="sub small" style="display:block">${u===x.owner?"Created the space":x.invited.includes(u)?"Invited":x.role==="joining"&&u===Cloud.uid?"Joining":"Member"}</span></span>${owner&&u!==Cloud.uid?`<button class="btn sm ghost" data-act="spRemove" data-id="${esc(x.id)}" data-u="${esc(u)}" aria-label="Remove ${esc(Soc.handle(u))}">Remove</button>`:""}</div>`).join("")}</div>
    ${owner?`<button class="btn sm danger" style="align-self:flex-start" data-act="spDelete" data-id="${esc(x.id)}">Delete space</button>`:`<button class="btn sm ghost" style="align-self:flex-start" data-act="spLeave" data-id="${esc(x.id)}">Leave</button>`}</div>`};
  return hdr("Shared spaces")+`<div class="scroll">${spaceInvitesCard()}
   ${mine.length?mine.map(card).join(""):`<p class="sub">You're not in a shared space yet.</p>`}
   <div class="card line"><h3>New shared space</h3><label class="f" for="sp-name">Name<input type="text" id="sp-name" maxlength="40" placeholder="Us" autocomplete="off" value="${esc(ui.spName||"")}"></label>
    ${conns.length?`<div class="col"><span class="tiny">Invite from your connections</span><div class="chips">${conns.map(i=>`<button class="chip" data-act="spPick" data-v="${esc(i)}" aria-pressed="${pick.includes(i)}">${esc(Soc.handle(i))}</button>`).join("")}</div></div>`:`<p class="sub small">You have no connections yet.</p>`}
    ${ui.err?`<p class="err" role="alert">${esc(ui.err)}</p>`:""}<button class="btn primary block ${ui.busy?"busy":""}" data-act="spCreate" ${conns.length?"":"disabled"}>Create and invite</button>
    <button class="link small" data-act="tab" data-tab="social">Find or add a connection</button>
    <p class="tiny">Each person joins only if they accept. Anyone can leave at any time, and the space then gets a new key. Space contents are encrypted in your browsers before they're stored.</p></div></div>`}

/* ---------------- actions ---------------- */
function blankX(kind){return{editing:null,kind,title:"",date:kind==="plan"?"":dayKey(Date.now()),cat:kind==="plan"?"other":"dinner",location:"",favorite:"",mood:"",notes:"",sharedNote:"",space:null,anniv:false,photos:[],added:[],removed:[],idea:null}}
function dateFromInput(v){if(!v)return null;const t=new Date(v+"T12:00").getTime();return isNaN(t)?NaN:t}
Object.assign(A,{
  iSeg(e){ui.int.seg=e.dataset.v;render(true)},
  discSeg(e){ui.disc.seg=e.dataset.v;if(ui.tab!=="discover"||ui.page)go("discover");else render(true)},
  fOpen(e,ev){ev&&ev.preventDefault();ui.disc.open=!ui.disc.open;render()},
  fSet(e){const k=e.dataset.k,v=e.dataset.v;ui.disc.f[k]=v===""?null:(k==="w"||k==="ds")?v:+v;render()},
  fInt(e){const g=ui.disc.f.g=ui.disc.f.g||[],v=e.dataset.v;ui.disc.f.g=g.includes(v)?g.filter(x=>x!==v):g.concat([v]);render()},
  fClear(){ui.disc.f={};render()},
  sugNext(){ui.sugOff=(ui.sugOff||0)+1;render()},
  ideaSave(e){const x=IDEA[e.dataset.v];if(!x||S.exps.some(z=>z.kind==="plan"&&z.idea===x.id))return;const now=Date.now();
    S.exps.push({id:uid(),kind:"plan",title:x.t,date:null,cat:"other",location:"",favorite:"",mood:"",notes:"",sharedNote:"",space:null,anniv:false,photos:[],idea:x.id,createdAt:now,updatedAt:now});save();render();toast("Saved to your plans.")},
  matchSave(e){const x=IDEA[e.dataset.v],sp=ui.disc.space;if(!x||!Soc.sp[sp])return;const now=Date.now();
    S.exps.push({id:uid(),kind:"plan",title:x.t,date:null,cat:"other",location:"",favorite:"",mood:"",notes:"",sharedNote:"",space:sp,anniv:false,photos:[],idea:x.id,createdAt:now,updatedAt:now});save();Soc.sched();render();toast("Planned. Everyone in "+Soc.sp[sp].name+" can see it.")},
  pickSpace(e){ui.disc.space=e.dataset.v;render()},
  pickToggle(e){const sp=ui.disc.space;if(!Soc.sp[sp])return;const cur=S.picks[sp]||[],v=e.dataset.v;S.picks[sp]=cur.includes(v)?cur.filter(x=>x!==v):cur.concat([v]);save();buzz(8);Soc.sched();render()},
  planSched(e){const x=S.exps.find(z=>z.id===e.dataset.id);if(!x)return;ui.err="";sheet({type:"sched",id:x.id,val:x.date?toLocalInput(x.date):""})},
  schedSave(){const x=S.exps.find(z=>z.id===ui.sheet.id),v=($("#sch-in")||{}).value;if(!x)return A.closeSheet();if(!v){x.date=null}else{const t=new Date(v).getTime();if(isNaN(t)){ui.err="Pick a date and time.";return render()}x.date=t}
    x.updatedAt=Date.now();ui.sheet=null;ui.err="";save();Soc.sched();render();toast(x.date?"Scheduled for "+fmtDate(x.date)+".":"Unscheduled.")},
  planDone(e){const x=S.exps.find(z=>z.id===e.dataset.id);if(!x)return;ui.xd={...blankX("done"),editing:x.id,fromPlan:true,title:x.title,date:dayKey(x.date&&x.date<=Date.now()?x.date:Date.now()),cat:x.cat==="other"&&x.idea?"adventure":x.cat,location:x.location||"",notes:x.notes||"",sharedNote:x.sharedNote||"",space:x.space||null,photos:(x.photos||[]).slice(),idea:x.idea};
    if(x.idea){const it=IDEA[x.idea];ui.xd.cat=it.g.includes("food")?"dinner":it.g.includes("romance")?"romantic":it.ds==="away"?"trip":it.g.includes("music")||it.g.includes("culture")?"celebration":"adventure"}
    openPage({type:"expEdit",from:ui.page})},
  storyFilter(e){ui.story.space=e.dataset.v;render()},
  expNew(e){ui.xd=blankX(e.dataset.kind||"done");ui.err="";openPage({type:"expEdit",from:ui.page})},
  expOpen(e){openPage({type:"exp",id:e.dataset.id,a:e.dataset.a,from:ui.page})},
  expEdit(e){const x=S.exps.find(z=>z.id===e.dataset.id);if(!x)return;ui.err="";
    ui.xd={...blankX(x.kind),editing:x.id,title:x.title,date:x.date?dayKey(x.date):"",cat:x.cat,location:x.location||"",favorite:x.favorite||"",mood:x.mood||"",notes:x.notes||"",sharedNote:x.sharedNote||"",space:x.space&&Soc.sp[x.space]?x.space:null,anniv:!!x.anniv,photos:(x.photos||[]).slice(),idea:x.idea||null,keepTime:x.date};openPage({type:"expEdit",from:ui.page})},
  xCat(e){ui.xd.cat=e.dataset.v;if(ui.xd.cat!=="milestone")ui.xd.anniv=false;render()},
  xMood(e){ui.xd.mood=ui.xd.mood===e.dataset.v?"":e.dataset.v;render()},
  xSpace(e){ui.xd.space=e.dataset.v||null;render()},
  xAnniv(){ui.xd.anniv=!ui.xd.anniv;render()},
  xPhotoDel(e){const d=ui.xd,id=e.dataset.id;d.photos=d.photos.filter(x=>x!==id);if(d.added.includes(id)){d.added=d.added.filter(x=>x!==id);Photos.del(id)}else d.removed.push(id);render()},
  expSave(){const d=ui.xd,title=String(d.title||"").trim();
    if(!title){ui.err="Give it a short title.";return render()}
    let date=dateFromInput(d.date);if(Number.isNaN(date)){ui.err="That date isn't valid.";return render()}
    if(d.kind==="done"){if(date===null){ui.err="Pick the date it happened.";return render()}if(date>Date.now()+DAY){ui.err="A memory can't be in the future. Save it as a plan instead.";return render()}}
    if(d.keepTime&&date&&dayKey(d.keepTime)===d.date)date=d.keepTime;
    if(d.space&&!Soc.sp[d.space]){ui.err="That space isn't available any more.";return render()}
    const now=Date.now(),rec={kind:d.kind,title:title.slice(0,80),date,cat:XCATS[d.cat]?d.cat:"other",location:String(d.location||"").trim().slice(0,80),favorite:String(d.favorite||"").trim().slice(0,200),mood:MC[d.mood]?d.mood:"",notes:String(d.notes||"").trim().slice(0,2000),sharedNote:d.space?String(d.sharedNote||"").trim().slice(0,500):"",space:d.space||null,anniv:d.cat==="milestone"&&!!d.anniv,photos:d.photos.slice(0,6),idea:d.idea||null,updatedAt:now};
    let id=d.editing;if(id){const x=S.exps.find(z=>z.id===id);if(x)Object.assign(x,rec);else id=null}
    if(!id){id=uid();S.exps.push({id,createdAt:now,...rec})}
    d.removed.forEach(p=>Photos.del(p));ui.xd=null;ui.err="";save();Soc.sched();
    ui.page={type:"exp",id,a:"me",from:d.fromPlan||!d.editing?{type:null}:ui.page.from&&ui.page.from.from||null};if(ui.page.from&&!ui.page.from.type)ui.page.from=null;
    render(true);toast(d.fromPlan?"Moved to Our Story.":d.editing?"Saved.":d.kind==="plan"?"Plan saved.":"Memory saved.")},
  expDelAsk(e){const id=e.dataset.id,x=S.exps.find(z=>z.id===id);if(!x)return;sheet({type:"confirm",title:"Delete this "+(x.kind==="plan"?"plan":"memory")+"?",body:"It's removed from this device"+(S.user.mode==="account"?", your synced copy":"")+(x.space?" and the shared space":"")+", with its photos. This can't be undone.",yes:"Delete",danger:true,fn(){
    (x.photos||[]).forEach(p=>Photos.del(p));S.exps=S.exps.filter(z=>z.id!==id);S.deleted[id]=Date.now();save();Soc.sched();ui.page=null;render(true);toast("Deleted.")}})},
  quick(){ui.err="";sheet({type:"quick",cat:"couple",n:3,min:null})},
  qCat(e){ui.sheet.cat=e.dataset.v;render()},qP(e){ui.sheet.n=clampP(ui.sheet.n+ +e.dataset.d);render()},
  qDur(e){ui.sheet.min=+e.dataset.v;render()},
  qSave(){const q=ui.sheet;if(!q.min){ui.err="Pick about how long.";return render()}const now=Date.now(),dur=q.min*60,start=now-dur*1e3;
    const dup=S.sessions.find(s=>!s.demo&&Math.abs(s.start-start)<=6e4&&Math.abs(s.durationSec-dur)<=5);if(dup){ui.sheet=null;render();return toast("That's already saved.")}
    S.sessions.push({id:uid(),title:"",start,durationSec:dur,segments:null,category:q.cat,participants:q.cat==="poly"?clampP(q.n):2,satisfaction:null,sharedNote:"",tags:[],mood:"",notes:"",reflection:"",hrAvg:"",hrPeak:"",people:[],createdAt:now,updatedAt:now});
    ui.sheet=null;ui.err="";save();buzz(25);render();toast("Saved privately, as an estimate.")},
  spPick(e){ui.spName=($("#sp-name")||{}).value||"";const p=ui.spPick=ui.spPick||[],v=e.dataset.v;ui.spPick=p.includes(v)?p.filter(x=>x!==v):p.concat([v]);render()},
  spCreate(){const name=(($("#sp-name")||{}).value||"").trim(),pick=(ui.spPick||[]).filter(u=>Soc.conns().includes(u));ui.spName=name;
    if(!name){ui.err="Name the space.";return render()}if(!pick.length){ui.err="Invite at least one connection.";return render()}
    return busy(async()=>{try{const it=await Soc.sealSpace({id:uid(),name:name.slice(0,40),owner:Cloud.uid,members:[],invited:pick,v:1});const cur=Soc.spaces[Cloud.uid]||{};await Soc.saveSpaces((cur.items||[]).concat([it]));
      ui.spPick=[];ui.spName="";ui.err="";toast("Space created. "+names(pick)+" can join.")}catch(x){ui.err="The space couldn't be created. Nothing was shared."}})},
  spAccept(e){const x=Soc.sp[e.dataset.id];if(!x)return;busy(async()=>{try{await Soc.answerSpace(x,true);toast("You joined "+x.name+".")}catch(z){toast("That couldn't be saved. Try again.")}})},
  spDecline(e){const x=Soc.sp[e.dataset.id];if(!x)return;busy(async()=>{try{await Soc.answerSpace(x,false);toast("Declined.")}catch(z){toast("That couldn't be saved. Try again.")}})},
  spLeave(e){const x=Soc.sp[e.dataset.id];if(!x)return;sheet({type:"confirm",title:"Leave "+x.name+"?",body:"You stop seeing what others share there, your picks are withdrawn, and anything you shared into it becomes private again.",yes:"Leave",danger:true,fn(){busy(async()=>{
    try{await Soc.answerSpace(x,false)}catch(z){return toast("That couldn't be saved. Try again.")}delete S.picks[x.id];S.exps.forEach(z=>{if(z.space===x.id){z.space=null;z.sharedNote="";z.updatedAt=Date.now()}});save();Soc.sched();toast("You left "+x.name+".")})}})},
  spRemove(e){const x=Soc.sp[e.dataset.id],u=e.dataset.u;if(!x||x.role!=="owner")return;sheet({type:"confirm",title:"Remove "+Soc.handle(u)+"?",body:"They lose access to "+x.name+", and the space gets a new key.",yes:"Remove",danger:true,fn(){busy(async()=>{
    const items=[];for(const it of ((Soc.spaces[Cloud.uid]||{}).items||[]))items.push(it===x.item?await Soc.sealSpace({id:x.id,name:x.name,owner:Cloud.uid,members:x.members.filter(v=>v!==u),invited:x.invited.filter(v=>v!==u),v:x.v+1}):it);
    await Soc.saveSpaces(items);toast("Removed.")})}})},
  spDelete(e){const x=Soc.sp[e.dataset.id];if(!x||x.role!=="owner")return;sheet({type:"confirm",title:"Delete "+x.name+"?",body:"Everyone loses access to it. Your own memories in it become private again. This can't be undone.",yes:"Delete space",danger:true,fn(){busy(async()=>{
    await Soc.saveSpaces(((Soc.spaces[Cloud.uid]||{}).items||[]).filter(it=>it!==x.item));delete S.picks[x.id];S.exps.forEach(z=>{if(z.space===x.id){z.space=null;z.sharedNote="";z.updatedAt=Date.now()}});save();Soc.sched();toast("Space deleted.")})}})}
});
document.addEventListener("change",async ev=>{const t=ev.target;if(t.id!=="x-photo"||!ui.xd)return;const files=Array.from(t.files||[]).slice(0,6-ui.xd.photos.length);
  for(const f of files){try{const b=await shrink(f),id=uid();await Photos.put(id,b);ui.xd.photos.push(id);ui.xd.added.push(id)}catch(e){toast("A photo couldn't be added.")}}render()});
