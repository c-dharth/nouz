# Copy to .env and fill in. Never commit .env. With these left blank VOUZ runs fully offline, local-only.

# --- App (safe to ship; row-level security is what protects data, not secrecy of these) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# development | production. Simulated purchases are only honoured when this is development.
VITE_APP_ENV=development
VITE_ALLOW_MOCK_PURCHASES=false

# --- Server only (Supabase function secrets). NEVER put these in the app or in a VITE_ variable ---
SUPABASE_SERVICE_ROLE_KEY=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
